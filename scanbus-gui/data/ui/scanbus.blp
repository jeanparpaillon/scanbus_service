// scanbus.ui — Blueprint description of the scanbus GNOME client's widget tree.
//
// Transcribed from the hand-built widgets in `scanbus-gui/src/`: window.rs (window,
// sidebar, settings page), scanners.rs (scanners pane, scanner rows), details.rs
// (right-hand detail pane), buttons.rs (Configure buttons page and its rows),
// profiles.rs and options.rs (the Profiles view).
//
// What is here and what is not:
//
//   * Every widget whose *shape* is fixed at build time is declared, with the id the
//     Rust code holds it by, so a port to `gtk::Builder` is a lookup per id.
//   * Content that the store fills in at runtime (labels, subtitles, sensitivity,
//     visibility, css status classes, stack page switches) is left at its initial
//     value — the same value the Rust constructor gives it.
//   * The list rows and option rows are built one per model item, so they cannot be
//     plain ids in one builder file. They are collected at the end as the *shapes*
//     they are constructed with; a real port would move each into its own .ui and
//     instantiate it per item.
//
// Signals are named, not resolved. Each `=> $handler()` gives the handler name a port
// would declare, and the comment above it says what the closure installed at that site
// in `scanbus-gui/src/` does today. They cannot become plain `gtk::Builder` callbacks:
// every one of them closes over the store or the bus command channel, which a free
// function reached by name cannot see. The shape that does work is a
// `gtk::CompositeTemplate` subclass per widget, whose `#[template_callback]` methods
// reach both through the object they hang off.
//
// Callbacks that are not GObject signals are left out: the store's own
// `connect_changed` / `connect_toast` (scanners.rs, store.rs) and the `connect_write`
// an OptionsEditor exposes (options.rs) are Rust callbacks on plain structs, with no
// signal to bind to. Everything they drive is the runtime content this file does not
// carry.
//
// GActions, which the widgets name rather than connect to:
//
//   * `app.quit` — main.rs. The only menu item.
//   * `win.retry-pair`, string target: the object path — window.rs. Activated by the
//     toast a failed pairing raises, not by any widget declared here.
//   * `app.open-file`, `app.open-folder`, `app.show-scanner`, string targets —
//     notify.rs. Activated from desktop notifications.
//   * `scanner.default-profile` and `button.profile`, string target: the profile name,
//     empty for unassigned — buttons.rs. Stateful, one per page and one per key row;
//     their menu models are rebuilt from `Scanner1.SupportedProfiles`, so neither the
//     models nor the action groups can be declared here.

using Gtk 4.0;
using Adw 1;

// ---------------------------------------------------------------------------
// Menus — window.rs
// ---------------------------------------------------------------------------

menu app_menu {
  item ("Quit", "app.quit")
}

// ---------------------------------------------------------------------------
// The window — window.rs `build_window`
// ---------------------------------------------------------------------------

Adw.ApplicationWindow window {
  title: "Scanbus";
  default-width: 1180;
  default-height: 720;

  // Stops discovery, then destroys instead of closing while the background hold
  // is taken, so the app keeps running without a window.
  close-request => $on_close_request();

  content: Adw.ToastOverlay toast_overlay {
    child: Gtk.Box root_box {
      orientation: vertical;
      spacing: 0;

      Adw.HeaderBar header {
        [end]
        Gtk.MenuButton menu_button {
          icon-name: "open-menu-symbolic";
          menu-model: app_menu;
        }

        [end]
        Gtk.Spinner spinner {
          spinning: false;
          visible: false;
        }

        [end]
        Gtk.Button find_button {
          label: "Find scanners…";

          // One button for both directions: starts discovery when idle, stops
          // it while it runs, and does nothing while a stop is in flight.
          clicked => $on_find_clicked();
        }
      }

      Gtk.Box content_box {
        orientation: horizontal;
        spacing: 0;

        // -- Sidebar ------------------------------------------------------
        Gtk.Box sidebar {
          orientation: vertical;
          spacing: 12;
          margin-top: 18;
          margin-bottom: 18;
          margin-start: 18;
          margin-end: 18;
          width-request: 220;

          // The page name each row selects is its widget name, read back in
          // `row-selected` and passed to the stack.
          Gtk.ListBox sections {
            selection-mode: single;

            // Clears the footer's selection, then switches `page_stack` to the
            // row's name.
            row-selected => $on_section_selected();

            styles ["navigation-sidebar"]

            Gtk.ListBoxRow scanners_row {
              name: "scanners";

              child: Gtk.Label {
                label: "Scanners";
                xalign: 0;
                margin-top: 12;
                margin-bottom: 12;
                margin-start: 12;
                margin-end: 12;
              };
            }

            Gtk.ListBoxRow profiles_row {
              name: "profiles";

              child: Gtk.Label {
                label: "Profiles";
                xalign: 0;
                margin-top: 12;
                margin-bottom: 12;
                margin-start: 12;
                margin-end: 12;
              };
            }
          }

          Gtk.Box sidebar_spacer {
            orientation: vertical;
            spacing: 0;
            vexpand: true;
          }

          Gtk.ListBox footer {
            selection-mode: single;

            // Mirror of `sections`: clears that selection, then switches
            // `page_stack`.
            row-selected => $on_footer_selected();

            styles ["navigation-sidebar"]

            Gtk.ListBoxRow settings_row {
              name: "settings";

              child: Gtk.Label {
                label: "Settings";
                xalign: 0;
                margin-top: 12;
                margin-bottom: 12;
                margin-start: 12;
                margin-end: 12;
              };
            }
          }
        }

        Gtk.Separator {
          orientation: vertical;
        }

        // -- Pages --------------------------------------------------------
        Gtk.Stack page_stack {
          hexpand: true;
          vexpand: true;

          Gtk.StackPage {
            name: "scanners";
            child: Gtk.Box scanners_pane {
              orientation: vertical;
              spacing: 0;
              hexpand: true;
              vexpand: true;

              // ---- Service banner — scanners.rs -------------------------
              // Revealed while the daemon is absent from the session bus.
              Gtk.Revealer service_banner {
                transition-type: slide_down;
                reveal-child: false;

                child: Gtk.Box service_banner_body {
                  orientation: horizontal;
                  spacing: 0;
                  margin-top: 12;
                  margin-bottom: 12;
                  margin-start: 18;
                  margin-end: 18;

                  styles ["toolbar"]

                  Gtk.Label service_banner_label {
                    label: "Scanbus service is not running";
                    xalign: 0;
                  }
                };
              }

              // ---- Content / empty ------------------------------------
              Gtk.Stack scanners_stack {
                vexpand: true;

                Gtk.StackPage {
                  name: "content";
                  child: Gtk.Box scanners_content {
                    orientation: horizontal;
                    spacing: 0;
                    vexpand: true;

                    // ---- Scanner lists --------------------------------
                    Gtk.ScrolledWindow list_scroller {
                      hscrollbar-policy: never;
                      min-content-width: 420;
                      hexpand: true;
                      vexpand: true;

                      child: Gtk.Box lists {
                        orientation: vertical;
                        spacing: 18;
                        margin-top: 24;
                        margin-bottom: 24;
                        margin-start: 24;
                        margin-end: 24;

                        // Both groups are hidden while their filtered model is
                        // empty; the discovered group's *description* is where
                        // the "Finding scanners… N found" caption is shown.
                        Adw.PreferencesGroup paired_group {
                          title: "Paired scanners";

                          Gtk.ListBox paired_list {
                            selection-mode: single;

                            // The two lists clear each other's selection, so
                            // one scanner is selected across both; the selected
                            // row's widget name is the path handed to the
                            // store.
                            row-selected => $on_paired_selected();

                            styles ["boxed-list"]
                          }
                        }

                        Adw.PreferencesGroup discovered_group {
                          title: "Discovered scanners";

                          Gtk.ListBox discovered_list {
                            selection-mode: single;

                            // Mirror of `paired_list`.
                            row-selected => $on_discovered_selected();

                            styles ["boxed-list"]
                          }
                        }
                      };
                    }

                    Gtk.Separator {
                      orientation: vertical;
                    }

                    // ---- Right-hand pane ------------------------------
                    Gtk.Stack detail_stack {
                      visible-child-name: "placeholder";

                      Gtk.StackPage {
                        name: "placeholder";
                        child: Adw.StatusPage detail_placeholder {
                          title: "No scanner selected";
                          description: "Select a scanner to inspect it";
                        };
                      }

                      Gtk.StackPage {
                        name: "details";
                        child: Gtk.ScrolledWindow detail_scroller {
                          hscrollbar-policy: never;
                          min-content-width: 360;

                          // ---- Details pane — details.rs ---------------
                          child: Gtk.Box details_pane {
                            orientation: vertical;
                            spacing: 24;
                            margin-top: 24;
                            margin-bottom: 24;
                            margin-start: 24;
                            margin-end: 24;

                            // Identity: icon, name, and the summary line whose
                            // first half carries the status colour.
                            Gtk.Box details_identity {
                              orientation: vertical;
                              spacing: 12;

                              Gtk.Image details_icon {
                                icon-name: "printer-symbolic";
                                pixel-size: 80;
                                halign: center;
                              }

                              Gtk.Label details_name {
                                wrap: true;
                                justify: center;

                                styles ["title-2"]
                              }

                              Gtk.Box details_summary {
                                orientation: horizontal;
                                spacing: 0;
                                halign: center;

                                Gtk.Label details_summary_status {}

                                Gtk.Label details_summary_rest {}
                              }
                            }

                            Gtk.Separator {
                              orientation: horizontal;
                            }

                            // Facts: icon / label / value, one shape per row.
                            Gtk.Box details_facts {
                              orientation: vertical;
                              spacing: 18;

                              Gtk.Box {
                                orientation: horizontal;
                                spacing: 12;

                                Gtk.Image {
                                  icon-name: "network-cellular-signal-excellent-symbolic";

                                  styles ["dim-label"]
                                }

                                Gtk.Label {
                                  label: "Status";
                                  xalign: 0;
                                }

                                Gtk.Box {
                                  hexpand: true;
                                }

                                Gtk.Label details_status {
                                  xalign: 1;
                                  halign: end;
                                  wrap: true;
                                }
                              }

                              Gtk.Box {
                                orientation: horizontal;
                                spacing: 12;

                                Gtk.Image {
                                  icon-name: "network-wireless-hotspot-symbolic";

                                  styles ["dim-label"]
                                }

                                Gtk.Label {
                                  label: "Connection";
                                  xalign: 0;
                                }

                                Gtk.Box {
                                  hexpand: true;
                                }

                                Gtk.Label details_connection {
                                  xalign: 1;
                                  halign: end;
                                  wrap: true;
                                }
                              }

                              Gtk.Box {
                                orientation: horizontal;
                                spacing: 12;

                                Gtk.Image {
                                  icon-name: "network-wired-symbolic";

                                  styles ["dim-label"]
                                }

                                Gtk.Label {
                                  label: "Address";
                                  xalign: 0;
                                }

                                Gtk.Box {
                                  hexpand: true;
                                }

                                Gtk.Label details_address {
                                  xalign: 1;
                                  halign: end;
                                  wrap: true;
                                  selectable: true;
                                }
                              }

                              Gtk.Box {
                                orientation: horizontal;
                                spacing: 12;

                                Gtk.Image {
                                  icon-name: "application-x-sharedlib-symbolic";

                                  styles ["dim-label"]
                                }

                                Gtk.Label {
                                  label: "Backend";
                                  xalign: 0;
                                }

                                Gtk.Box {
                                  hexpand: true;
                                }

                                Gtk.Label details_backend {
                                  xalign: 1;
                                  halign: end;
                                  wrap: true;
                                }
                              }

                              Gtk.Box {
                                orientation: horizontal;
                                spacing: 12;

                                Gtk.Image {
                                  icon-name: "text-x-generic-symbolic";

                                  styles ["dim-label"]
                                }

                                Gtk.Label {
                                  label: "Default profile";
                                  xalign: 0;
                                }

                                Gtk.Box {
                                  hexpand: true;
                                }

                                Gtk.Label details_default_profile {
                                  xalign: 1;
                                  halign: end;
                                  wrap: true;
                                }
                              }
                            }

                            // The bottom section is pairing-only: rule and box
                            // are shown together or not at all.
                            Gtk.Separator details_actions_separator {
                              orientation: horizontal;
                              visible: false;
                            }

                            Gtk.Box details_actions {
                              orientation: vertical;
                              spacing: 12;
                              visible: false;

                              Gtk.ListBox details_configure_list {
                                selection-mode: none;

                                // Wired on the list, not on the row: a plain
                                // Gtk.ListBox is what emits `row-activated` for
                                // the click, with no Adw.PreferencesGroup in
                                // between to forward it to the row's own
                                // activation. Switches `detail_stack` to
                                // "buttons", only for a scanner that is still
                                // paired.
                                row-activated => $on_configure_activated();

                                styles ["boxed-list"]

                                Adw.ActionRow details_configure_row {
                                  title: "Configure buttons";
                                  activatable: true;

                                  [prefix]
                                  Gtk.Image {
                                    icon-name: "preferences-other-symbolic";
                                  }

                                  [suffix]
                                  Gtk.Image {
                                    icon-name: "go-next-symbolic";
                                  }
                                }
                              }

                              Gtk.Button details_unpair {
                                label: "Unpair";
                                halign: fill;

                                // Raises `unpair_dialog` below; nothing is sent
                                // until it is confirmed.
                                clicked => $on_unpair_clicked();

                                styles ["destructive-action"]
                              }
                            }
                          };
                        };
                      }

                      Gtk.StackPage {
                        name: "buttons";
                        child: Gtk.ScrolledWindow buttons_scroller {
                          hscrollbar-policy: never;
                          min-content-width: 360;

                          // ---- Configure buttons — buttons.rs ----------
                          child: Gtk.Box buttons_page {
                            orientation: vertical;
                            spacing: 18;
                            margin-top: 24;
                            margin-bottom: 24;
                            margin-start: 24;
                            margin-end: 24;

                            Gtk.Box buttons_header {
                              orientation: horizontal;
                              spacing: 12;

                              Gtk.Button buttons_back {
                                label: "Back";

                                // Back to "details" in `detail_stack`.
                                clicked => $on_buttons_back();

                                styles ["flat"]
                              }

                              Gtk.Label buttons_title {
                                label: "Configure buttons";
                                xalign: 0;
                                hexpand: true;

                                styles ["title-3"]
                              }
                            }

                            // Which scanner this page is about, plus the one
                            // switch that connects and disconnects it.
                            Gtk.Box buttons_banner {
                              orientation: vertical;
                              spacing: 12;
                              margin-top: 6;
                              margin-bottom: 6;
                              margin-start: 6;
                              margin-end: 6;

                              styles ["card"]

                              Gtk.Label buttons_banner_title {
                                xalign: 0;
                                wrap: true;

                                styles ["heading"]
                              }

                              Gtk.Label buttons_banner_address {
                                xalign: 0;
                                wrap: true;

                                styles ["dim-label"]
                              }

                              Gtk.Box buttons_connection_row {
                                orientation: horizontal;
                                spacing: 12;

                                Gtk.Box buttons_connection_text {
                                  orientation: vertical;
                                  spacing: 4;

                                  Gtk.Label {
                                    label: "Connection";
                                    xalign: 0;

                                    styles ["heading"]
                                  }

                                  Gtk.Label buttons_connection_hint {
                                    xalign: 0;
                                    wrap: true;

                                    styles ["dim-label"]
                                  }
                                }

                                Gtk.Box {
                                  hexpand: true;
                                }

                                Gtk.Switch buttons_connection_switch {
                                  halign: end;
                                  valign: center;

                                  // Sends Connect or Disconnect and always
                                  // returns Propagation::Stop: the switch shows
                                  // `Scanner1`'s state, so it moves when the
                                  // daemon says so and not when the pointer says
                                  // so. Ignored entirely while the scanner is
                                  // unpaired or offline.
                                  state-set => $on_connection_state_set();
                                }
                              }
                            }

                            // One row per device key; see `button_row` below.
                            Adw.PreferencesGroup buttons_group {
                              title: "Scanner buttons";
                              description: "Each physical button on your scanner can start a profile without opening your computer.";

                              Gtk.ListBox buttons_list {
                                selection-mode: none;

                                styles ["boxed-list"]
                              }
                            }

                            // Shown instead of the group: "no keys" and "keys
                            // not readable yet" say different things.
                            Gtk.Label buttons_empty {
                              xalign: 0;
                              wrap: true;
                              visible: false;

                              styles ["dim-label"]
                            }

                            Adw.PreferencesGroup default_profile_group {
                              title: "Default profile";
                              description: "Profile applied by default to data received without an explicit profile.";

                              Gtk.ListBox default_profile_list {
                                selection-mode: none;

                                styles ["boxed-list"]

                                Gtk.ListBoxRow default_profile_row {
                                  selectable: false;
                                  activatable: false;

                                  child: Gtk.Box {
                                    orientation: horizontal;
                                    spacing: 12;
                                    margin-top: 12;
                                    margin-bottom: 12;
                                    margin-start: 12;
                                    margin-end: 12;

                                    // Menu model is rebuilt from the scanner's
                                    // SupportedProfiles, so it has none here. Menu
                                    // model is rebuilt from the scanner's
                                    // SupportedProfiles, so it has none here;
                                    // every item targets `scanner.default-profile`
                                    // with the profile name.
                                    Gtk.MenuButton default_profile_button {
                                      valign: center;
                                    }

                                    Gtk.Box {
                                      hexpand: true;
                                    }

                                    Gtk.Label default_profile_summary {
                                      xalign: 1;
                                      wrap: true;

                                      styles ["dim-label"]
                                    }

                                    Gtk.Button default_profile_configure {
                                      label: "Configure";
                                      valign: center;

                                      // Opens `options_dialog` on the scanner's
                                      // default profile, at Profile scope.
                                      clicked => $on_default_configure();

                                      styles ["flat"]
                                    }
                                  };
                                }
                              }
                            }
                          };
                        };
                      }
                    }
                  };
                }

                Gtk.StackPage {
                  name: "empty";
                  child: Adw.StatusPage scanners_empty_state {
                    title: "No scanners yet";
                    description: "Find scanners…";
                    vexpand: true;
                  };
                }
              }
            };
          }

          // ---- Profiles — profiles.rs -------------------------------------
          // One OptionsEditor group per exported Profile1 is inserted between
          // these two groups at render time.
          Gtk.StackPage {
            name: "profiles";
            child: Gtk.ScrolledWindow profiles_scroller {
              hscrollbar-policy: never;
              vscrollbar-policy: automatic;

              child: Adw.PreferencesPage profiles_page {
                Adw.PreferencesGroup profiles_absent_group {
                  title: "Profiles";
                  visible: false;

                  Adw.ActionRow {
                    title: "No profiles";
                    subtitle: "The scanbus service exports no profile objects. Start it from Settings, then come back.";
                  }
                }

                // A kind GetProfileTypes advertises with no Profile1 object
                // gets a row here rather than going missing.
                Adw.PreferencesGroup profiles_unimplemented_group {
                  title: "Not implemented yet";
                  description: "The service reports these profile types but exports no object for them, so they have no options to edit.";
                  visible: false;
                }
              };
            };
          }

          // ---- Settings — window.rs `settings_page` -----------------------
          Gtk.StackPage {
            name: "settings";
            child: Gtk.ScrolledWindow settings_scroller {
              hscrollbar-policy: never;
              vscrollbar-policy: automatic;

              child: Adw.PreferencesPage settings_page {
                Adw.PreferencesGroup daemon_group {
                  title: "Daemon";
                  description: "Read the scanbus daemon state without starting it, then start it explicitly when it is only activatable.";

                  Adw.ActionRow daemon_row {
                    title: "Service";

                    [suffix]
                    Gtk.Button daemon_start_button {
                      label: "Start";
                      valign: center;

                      // Asks the bus thread to start the daemon; the row's own
                      // text follows the store.
                      clicked => $on_start_service();
                    }
                  }

                  Adw.ActionRow daemon_version_row {
                    title: "Version";
                  }

                  Adw.ActionRow daemon_backends_row {
                    title: "Backends";
                  }

                  Adw.ActionRow daemon_profile_types_row {
                    title: "Profile types";
                  }
                }

                // Read-only here; activating a row jumps to Profiles.
                Adw.PreferencesGroup output_group {
                  title: "Default output folders";
                  description: "These folders are read-only here. Use Profiles to change them.";

                  Adw.ActionRow output_image_row {
                    title: "Image";
                    activatable: true;

                    // Both output rows do the same thing: jump to the Profiles
                    // page, where the folder is editable.
                    activated => $on_show_profiles();

                    [suffix]
                    Gtk.Image {
                      icon-name: "go-next-symbolic";
                    }
                  }

                  Adw.ActionRow output_document_row {
                    title: "Document";
                    activatable: true;

                    activated => $on_show_profiles();

                    [suffix]
                    Gtk.Image {
                      icon-name: "go-next-symbolic";
                    }
                  }
                }

                Adw.PreferencesGroup autostart_group {
                  title: "Background mode";
                  description: "The packaged GNOME session starts scanbus-gui in the background at login through XDG autostart.";

                  // Subtitle is written from the autostart override's state,
                  // or from the error that stopped it being read.
                  Adw.ActionRow autostart_row {
                    title: "Start in the background at login";
                    activatable-widget: autostart_toggle;

                    [suffix]
                    Gtk.Switch autostart_toggle {
                      valign: center;

                      // Writes the XDG autostart override. A failed write
                      // toasts and puts the switch back, which is why the
                      // handler has to guard against the notify its own revert
                      // raises.
                      notify::active => $on_autostart_toggled();
                    }
                  }
                }

                // Opens a Gtk.AboutDialog built at runtime, because its version
                // and repository come from the crate's own env!() values.
                Adw.PreferencesGroup about_group {
                  title: "About";

                  Adw.ActionRow about_row {
                    title: "About Scanbus";
                    subtitle: "GUI version, daemon version, repository and licence";
                    activatable: true;

                    // Builds the Gtk.AboutDialog described above.
                    activated => $on_about();

                    [suffix]
                    Gtk.Image {
                      icon-name: "go-next-symbolic";
                    }
                  }
                }
              };
            };
          }
        }
      }
    };
  };
}

// ===========================================================================
// Per-item shapes
//
// Everything below is built once per model item, not once per window, so the
// ids are shapes rather than singletons. Kept in this file because it is the
// whole of the GUI's widget vocabulary; a port would split each into its own
// .ui and instantiate it from the list model binding.
// ===========================================================================

// ---------------------------------------------------------------------------
// A row in either scanner list — scanners.rs `scanner_row`
//
// The row's widget name is the scanner's object path, which is how selection is
// reported back to the store. Name and status line are bound to the
// ScannerObject properties; the pairing sub-boxes are shown one at a time by
// PairingState, all three hidden when the scanner is not pairing.
// ---------------------------------------------------------------------------

Gtk.ListBoxRow scanner_row {
  selectable: true;
  activatable: true;

  // Activation selects: the row's widget name is the object path the store is
  // told.
  activate => $on_scanner_row_activate();

  child: Gtk.Box {
    orientation: vertical;
    spacing: 8;
    margin-top: 12;
    margin-bottom: 12;
    margin-start: 12;
    margin-end: 12;

    Gtk.Box {
      orientation: horizontal;
      spacing: 12;

      Gtk.Box {
        orientation: vertical;
        spacing: 4;

        Gtk.Label scanner_row_title {
          xalign: 0;

          styles ["heading"]
        }

        Gtk.Label scanner_row_subtitle {
          xalign: 0;

          styles ["dim-label"]
        }
      }

      Gtk.Box {
        hexpand: true;
      }

      // "Pair", then "Cancel" while pairing, "Try again" after a failure.
      Gtk.Button scanner_row_pair_button {
        label: "Pair";
        valign: center;

        // Pair, or cancel while pairing — the label says which, and the handler
        // reads the scanner's PairingState rather than the label to decide.
        clicked => $on_pair_clicked();
      }
    }

    Gtk.Box scanner_row_state_box {
      orientation: vertical;
      spacing: 8;

      Gtk.Box scanner_row_progress_box {
        orientation: horizontal;
        spacing: 8;
        visible: false;

        Gtk.Spinner scanner_row_spinner {
          halign: start;
        }

        Gtk.Label scanner_row_progress_label {
          xalign: 0;
          wrap: true;

          styles ["dim-label"]
        }
      }

      Gtk.Box scanner_row_confirm_box {
        orientation: vertical;
        spacing: 4;
        visible: false;

        Gtk.Label {
          label: "Confirm on your device";
          xalign: 0;
        }

        Gtk.Label scanner_row_code_label {
          xalign: 0;

          styles ["title-2", "monospace"]
        }
      }

      Gtk.Box scanner_row_failure_box {
        orientation: vertical;
        spacing: 6;
        visible: false;

        Gtk.Box scanner_row_failure_banner {
          orientation: vertical;
          spacing: 0;
          margin-top: 6;
          margin-bottom: 6;
          margin-start: 12;
          margin-end: 12;
          visible: false;

          styles ["error", "card"]

          Gtk.Label scanner_row_failure_message {
            wrap: true;
            xalign: 0;
            margin-top: 10;
            margin-bottom: 10;
            margin-start: 10;
            margin-end: 10;
          }
        }

        Gtk.Expander scanner_row_failure_details {
          label: "Details";
          expanded: false;

          child: Gtk.Label scanner_row_failure_details_label {
            selectable: true;
            wrap: true;
            xalign: 0;
          };
        }
      }
    }
  };
}

// ---------------------------------------------------------------------------
// A device key — buttons.rs `ButtonRow`
//
// The entry replaces the label text only on a device whose keys are writable;
// the caption appears only when the key's own label disagrees with the profile
// it runs. The profile menu is rebuilt from Scanner1.SupportedProfiles.
// ---------------------------------------------------------------------------

Gtk.ListBoxRow button_row {
  selectable: false;
  activatable: false;

  child: Gtk.Box {
    orientation: horizontal;
    spacing: 12;
    margin-top: 12;
    margin-bottom: 12;
    margin-start: 12;
    margin-end: 12;

    Gtk.Label button_row_index {
      width-chars: 2;
      valign: center;

      styles ["caption-heading", "numeric"]
    }

    Gtk.Box button_row_label_area {
      orientation: vertical;
      spacing: 4;
      hexpand: true;
      valign: center;

      Gtk.Label button_row_label_text {
        xalign: 0;
        wrap: true;
      }

      Gtk.Entry button_row_label_entry {
        visible: false;
        tooltip-text: "Press Enter to send this label to the device";

        // Enter writes the label to the device. The row then ignores the
        // store's value until that write comes back, so the text does not flick
        // to the old label.
        activate => $on_label_entry_activate();
      }

      Gtk.Label button_row_caption {
        xalign: 0;
        wrap: true;
        visible: false;

        styles ["dim-label", "caption"]
      }
    }

    // Menu rebuilt from Scanner1.SupportedProfiles; items target
    // `button.profile`.
    Gtk.MenuButton button_row_profile_button {
      valign: center;
    }

    Gtk.Label button_row_summary {
      xalign: 1;
      wrap: true;

      styles ["dim-label"]
    }

    Gtk.Button button_row_configure {
      label: "Configure";
      valign: center;

      // Opens `options_dialog` at Button scope, with the profile's options
      // inherited.
      clicked => $on_button_configure();

      styles ["flat"]
    }
  };
}

// ---------------------------------------------------------------------------
// Option rows — options.rs `build_row`
//
// One row per OptionsSchema entry, its class picked from the declared type:
// a closed string set is a ComboRow, integer a SpinRow, boolean a SwitchRow,
// path an ActionRow with a folder chooser, any other string an EntryRow, and
// anything this version cannot type stays a read-only ActionRow. Every
// editable row carries the same suffix: the origin pill, then Reset.
// ---------------------------------------------------------------------------

Adw.PreferencesGroup options_editor {
  // Shown instead of the rows when a profile publishes no options at all.
  Adw.ActionRow options_empty_row {
    title: "No options";
    subtitle: "This profile publishes no options for this version to edit.";
    visible: false;
  }

  Adw.ComboRow option_row_choice {
    model: Gtk.StringList {};

    // Every editable row commits on change — there is no separate Apply, except
    // on the entry row, where Adw.EntryRow's own apply button is the commit.
    notify::selected => $on_choice_changed();

    [suffix]
    Gtk.Box {
      orientation: horizontal;
      spacing: 6;
      valign: center;

      Gtk.Label option_row_choice_origin {
        valign: center;

        styles ["dim-label", "caption"]
      }

      Gtk.Button option_row_choice_reset {
        label: "Reset";
        valign: center;
        visible: false;

        // Every Reset is the same handler: clear the key at this editor's scope
        // and let the value fall back to what the pill says it inherits.
        clicked => $on_option_reset();

        styles ["flat"]
      }
    }
  }

  Adw.SpinRow option_row_number {
    adjustment: Gtk.Adjustment {
      step-increment: 1;
      page-increment: 10;
    };

    notify::value => $on_number_changed();

    [suffix]
    Gtk.Box {
      orientation: horizontal;
      spacing: 6;
      valign: center;

      Gtk.Label option_row_number_origin {
        valign: center;

        styles ["dim-label", "caption"]
      }

      Gtk.Button option_row_number_reset {
        label: "Reset";
        valign: center;
        visible: false;

        clicked => $on_option_reset();

        styles ["flat"]
      }
    }
  }

  Adw.SwitchRow option_row_flag {
    notify::active => $on_flag_toggled();

    [suffix]
    Gtk.Box {
      orientation: horizontal;
      spacing: 6;
      valign: center;

      Gtk.Label option_row_flag_origin {
        valign: center;

        styles ["dim-label", "caption"]
      }

      Gtk.Button option_row_flag_reset {
        label: "Reset";
        valign: center;
        visible: false;

        clicked => $on_option_reset();

        styles ["flat"]
      }
    }
  }

  Adw.EntryRow option_row_text {
    show-apply-button: true;

    apply => $on_text_applied();

    [suffix]
    Gtk.Box {
      orientation: horizontal;
      spacing: 6;
      valign: center;

      Gtk.Label option_row_text_origin {
        valign: center;

        styles ["dim-label", "caption"]
      }

      Gtk.Button option_row_text_reset {
        label: "Reset";
        valign: center;
        visible: false;

        clicked => $on_option_reset();

        styles ["flat"]
      }
    }
  }

  Adw.ActionRow option_row_folder {
    [suffix]
    Gtk.Box {
      orientation: horizontal;
      spacing: 6;
      valign: center;

      Gtk.Label option_row_folder_origin {
        valign: center;

        styles ["dim-label", "caption"]
      }

      Gtk.Button option_row_folder_reset {
        label: "Reset";
        valign: center;
        visible: false;

        clicked => $on_option_reset();

        styles ["flat"]
      }
    }

    [suffix]
    Gtk.Button option_row_folder_chooser {
      label: "Choose…";
      valign: center;

      // Runs the folder chooser, then commits the path it returns.
      clicked => $on_choose_folder();

      styles ["flat"]
    }
  }

  // No Reset: nothing here can be written, so nothing can be cleared.
  Adw.ActionRow option_row_read_only {
    [suffix]
    Gtk.Box {
      orientation: horizontal;
      spacing: 6;
      valign: center;

      Gtk.Label option_row_read_only_origin {
        valign: center;

        styles ["dim-label", "caption"]
      }
    }
  }
}

// ===========================================================================
// Dialogs
// ===========================================================================

// The unpair confirmation — scanners.rs. Transient for the window, and the
// body text names the scanner, so it is filled in before presenting.
Gtk.Window unpair_dialog {
  modal: true;
  title: "Unpair scanner?";

  child: Gtk.Box {
    orientation: vertical;
    spacing: 18;

    Gtk.Label unpair_dialog_body {
      wrap: true;
      xalign: 0;
      margin-top: 18;
      margin-bottom: 18;
      margin-start: 18;
      margin-end: 18;
    }

    Gtk.Box {
      orientation: horizontal;
      spacing: 12;
      halign: end;

      Gtk.Button unpair_dialog_cancel {
        label: "Cancel";

        clicked => $on_unpair_cancel();
      }

      Gtk.Button unpair_dialog_confirm {
        label: "Unpair";

        // Sends Unpair, then closes.
        clicked => $on_unpair_confirm();

        styles ["destructive-action"]
      }
    }
  };
}

// The options editor dialog — buttons.rs `open_options`. One per page at a
// time; opening a second closes the first. Its title names the profile and its
// body holds an `options_editor` group, whose Scope decides what the origin
// pill says and what Reset falls back to.
Gtk.Window options_dialog {
  modal: true;
  default-width: 520;

  // Clears the one-dialog-at-a-time slot, so the next Configure can open.
  close-request => $on_options_dialog_closed();

  child: Gtk.Box {
    orientation: vertical;
    spacing: 18;
    margin-top: 18;
    margin-bottom: 18;
    margin-start: 18;
    margin-end: 18;

    Gtk.Box {
      orientation: horizontal;
      spacing: 0;
      halign: end;

      Gtk.Button options_dialog_close {
        label: "Close";

        clicked => $on_options_close();
      }
    }
  };
}
