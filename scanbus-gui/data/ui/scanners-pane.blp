// The Scanners page — `scanners.rs` `ScannersPane`.
// Mockup: ../../../docs/design/main.png — the two lists on the left, the detail pane
// on the right.
//
// Every `=>` below is `swapped`, for the reason window.blp gives at length: a template
// handler is invoked with the emitting widget first and the template instance last, and
// `swapped` exchanges the two, so the Rust side writes `fn on_paired_selected(&self, …)`
// with the pane as `self` and reaches the store and the bus channel through
// `self.imp()`.

using Gtk 4.0;
using Adw 1;

template $ScannersPane : Gtk.Box {
  orientation: vertical;
  spacing: 0;
  hexpand: true;
  vexpand: true;

  // ---- Service banner ------------------------------------------------------
  // Revealed while the daemon is absent from the session bus.
  Gtk.Revealer service_banner {
    transition-type: slide_down;
    reveal-child: false;

    // An Adw.Bin where scanners.rs built a horizontal Gtk.Box: the box existed only to
    // carry the `toolbar` style and the margins around one label, and `Adw.Bin` is what
    // blueprint-compiler's lint wants for a single-child wrapper. Behaviour is
    // identical; the port changes the type here rather than keeping a box that never
    // holds a second child.
    child: Adw.Bin {
      margin-top: 12;
      margin-bottom: 12;
      margin-start: 18;
      margin-end: 18;

      styles ["toolbar"]

      child: Gtk.Label {
        label: _("Scanbus service is not running");
        xalign: 0;
      };
    };
  }

  // ---- Content / empty -----------------------------------------------------
  // Switched by `has_scanners`, not by discovery state: a stopped discovery that found
  // something keeps its results on screen.
  Gtk.Stack scanners_stack {
    vexpand: true;

    Gtk.StackPage {
      name: "content";
      child: Gtk.Box {
        orientation: horizontal;
        spacing: 0;
        vexpand: true;

        // ---- Scanner lists -------------------------------------------------
        Gtk.ScrolledWindow {
          hscrollbar-policy: never;
          min-content-width: 420;
          hexpand: true;
          vexpand: true;

          child: Gtk.Box {
            orientation: vertical;
            spacing: 18;
            margin-top: 24;
            margin-bottom: 24;
            margin-start: 24;
            margin-end: 24;

            // Both groups are hidden while their filtered model is empty, and the
            // discovered group's *description* is where the "Finding scanners… N found"
            // caption is written — there is no caption widget of its own.
            Adw.PreferencesGroup paired_group {
              title: _("Paired scanners");

              // Bound to a Gtk.FilterListModel over the store, one $ScannerRow per item.
              Gtk.ListBox paired_list {
                selection-mode: single;

                // The two lists clear each other's selection, so one scanner is selected
                // across both; the selected row's widget name is the path handed to the
                // store.
                row-selected => $on_paired_selected() swapped;

                styles ["boxed-list"]
              }
            }

            Adw.PreferencesGroup discovered_group {
              title: _("Discovered scanners");

              Gtk.ListBox discovered_list {
                selection-mode: single;

                // Mirror of `paired_list`.
                row-selected => $on_discovered_selected() swapped;

                styles ["boxed-list"]
              }
            }
          };
        }

        Gtk.Separator {
          orientation: vertical;
        }

        // ---- Right-hand pane -----------------------------------------------
        // Only the placeholder is declared. The other two pages hold `DetailsPane` and
        // `ButtonsPage`; `ButtonsPage` is not a template class yet — [10.24] — and a
        // `Gtk.StackPage` here has to name a child *class* the type system already
        // knows, or the whole template fails to instantiate rather than just that page.
        // `ScannersPane::new` adds both with `add_named`, which takes an instance. That
        // stays true for $DetailsPane now that it is one: each page is wrapped in a
        // Gtk.ScrolledWindow built there, and `ButtonsPage` is built with the bus channel
        // a builder-instantiated child could not be given.
        Gtk.Stack detail_stack {
          visible-child-name: "placeholder";

          Gtk.StackPage {
            name: "placeholder";
            child: Adw.StatusPage {
              title: _("No scanner selected");
              description: _("Select a scanner to inspect it");
            };
          }
        }
      };
    }

    Gtk.StackPage {
      name: "empty";
      child: Adw.StatusPage {
        title: _("No scanners yet");
        description: _("Find scanners…");
        vexpand: true;
      };
    }
  }
}
