// The Profiles page — the `$ProfilesPage` subclass `profiles.rs` declares.
// No mockup: §3 "Profiles" describes it in prose.
//
// The template's class is Adw.PreferencesPage itself, and not the Gtk.ScrolledWindow
// first written here. Two reasons, the second the stronger: gtk4-rs 0.10 ships no
// `ScrolledWindowImpl`, so a scroller cannot be a subclass's `ParentType` at all — the
// note in settings-page.blp says it at length — and AdwPreferencesPage already scrolls
// its own groups, so the outer scroller was a second scroller around a widget that had
// one. The page goes into the window's Gtk.Stack as itself.
//
// There is no declared group for `image` and none for `document`. One $OptionsEditor
// group per exported `Profile1` is built at render time and inserted **between** the two
// groups below, at index 1 and up — `adw_preferences_page_insert`, not `add`, so that the
// order below is what is drawn: `absent` first, then the daemon's profiles, then
// `unimplemented` last however many of them there are.

using Gtk 4.0;
using Adw 1;

template $ProfilesPage : Adw.PreferencesPage {
  // The title is never drawn: this page lives in a plain Gtk.Stack, not in an
  // Adw.PreferencesDialog with a view switcher. It is the page's accessible name.
  title: _("Profiles");

  // The daemon is not running, or exports no profile at all.
  Adw.PreferencesGroup absent {
    title: _("Profiles");
    visible: false;

    Adw.ActionRow {
      title: _("No profiles");
      subtitle: _("The scanbus service exports no profile objects. Start it from Settings, then come back.");
    }
  }

  // A kind GetProfileTypes advertises with no Profile1 object gets a row here rather
  // than going missing — API §6's `email` and `ocr`. The rows are one per missing kind,
  // built per render, so none is declared.
  Adw.PreferencesGroup unimplemented {
    title: _("Not implemented yet");
    description: _("The service reports these profile types but exports no object for them, so they have no options to edit.");
    visible: false;
  }
}
