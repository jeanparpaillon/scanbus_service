// The unpair confirmation — the template `unpair_dialog.rs` `UnpairDialog` is bound to,
// raised by the detail pane's Unpair button. No mockup: §7 of the GUI design owes the
// destructive action a confirmation, and this is it.
//
// Modal here; the transient parent is set by `UnpairDialog::new`, because it is the
// window this particular dialog was raised over. The body text names the scanner, so it
// is written there too.
//
// Both `=>` below are `swapped`: the dialog is `self`, and it is what closes.

using Gtk 4.0;

template $UnpairDialog : Gtk.Window {
  modal: true;
  title: _("Unpair scanner?");

  child: Gtk.Box {
    orientation: vertical;
    spacing: 18;

    Gtk.Label body {
      wrap: true;
      xalign: 0;
      margin-top: 18;
      margin-bottom: 18;
      margin-start: 18;
      margin-end: 18;
    }

    Gtk.Box {
      orientation: horizontal;
      spacing: 12;
      halign: end;

      Gtk.Button cancel {
        label: _("Cancel");

        clicked => $on_unpair_cancel() swapped;
      }

      // Sends Unpair, then closes. `scanners.rs` is not told: there is nothing left for
      // the pane to decide once this has been clicked.
      Gtk.Button confirm {
        label: _("Unpair");

        clicked => $on_unpair_confirm() swapped;

        styles ["destructive-action"]
      }
    }
  };
}
